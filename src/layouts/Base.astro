---
import { Font } from "astro:assets";
import katex from "katex";
import Header, { type NavItem } from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../lib/data";
import "../styles/global.css";

interface Props {
  /** Page title; omitted on the home page. */
  title?: string;
  description?: string;
  /** Section links for the header (home page only). */
  nav?: NavItem[];
  /** Load KaTeX styles (only when the page contains math). */
  math?: boolean;
  /** Absolute URL of a social preview image. */
  image?: string;
  noindex?: boolean;
}

const { title, description, nav = [], math = false, image, noindex = false } = Astro.props;

const affiliation = [profile.department?.name, profile.institution?.name].filter(Boolean).join(", ");
const summary = [profile.position, profile.field && `in ${profile.field}`, affiliation && `at ${affiliation}`]
  .filter(Boolean)
  .join(" ");
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.position}${profile.institution ? `, ${profile.institution.name}` : ""}`;
const pageDescription = description ?? `${profile.name} is a ${summary.charAt(0).toLowerCase()}${summary.slice(1)}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL("/og.png", Astro.site).href;

const sameAs = Object.values(profile.links).filter(Boolean);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: profile.position,
  ...(profile.institution && {
    affiliation: { "@type": "CollegeOrUniversity", name: profile.institution.name, url: profile.institution.url },
  }),
  ...(profile.interests.length > 0 && { knowsAbout: profile.interests }),
  ...(sameAs.length > 0 && { sameAs }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title ?? profile.name} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Apply a saved theme choice before first paint (avoids a flash).
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>

    <Font cssVariable="--font-serif" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-sans" preload />
    {math && <link rel="stylesheet" href={`/katex/katex.min.css?v=${katex.version}`} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header nav={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>

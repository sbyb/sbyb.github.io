---
import { profile } from "../lib/data";

const built = new Date();
const updated = built.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "Asia/Kolkata" });
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; {built.getFullYear()} {profile.name}</p>
    <p>Last updated {updated}</p>
  </div>
</footer>
